APP_MODE=DEMO
# Set APP_MODE=PRODUCTION and configure the public Supabase values for real accounts.
# When APP_MODE is omitted, missing Supabase credentials default to DEMO.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=only-for-secure-server-jobs
# Background notifications (server-only; never use NEXT_PUBLIC for private keys).
# Generate keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=
